<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/panel_bg"
    android:elevation="12dp"
    android:padding="14dp"
    android:layout_margin="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🎧 YupiSaver"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#2E7D5B" />

        <Button
            android:id="@+id/btnRefresh"
            android:layout_width="44dp"
            android:layout_height="40dp"
            android:text="🔄"
            android:textSize="14sp"
            android:background="@drawable/btn_bg"
            android:padding="0dp" />

        <Button
            android:id="@+id/btnClose"
            android:layout_width="44dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:text="✕"
            android:textSize="14sp"
            android:background="@drawable/btn_bg"
            android:padding="0dp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="快速開關（不用打開設定頁）"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#2E7D5B" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Switch
            android:id="@+id/swOverlayBluetooth"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="藍牙保活"
            android:textSize="12sp" />

        <Switch
            android:id="@+id/swOverlayActiveComfort"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="主動安慰"
            android:textSize="12sp" />
    </LinearLayout>

    <Switch
        android:id="@+id/swOverlayComfortAssistant"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="安慰播放完後開 ChatGPT 語音"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tvOverlayQuickStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:textColor="#7FA88F" />

    <!-- 按鈕動態生成：4 / 8 / 10 個，兩粒一行；太多時可以捲動 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="340dp"
        android:layout_marginTop="10dp">

        <LinearLayout
            android:id="@+id/llButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <LinearLayout
        android:id="@+id/llFollowup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <Button
            android:id="@+id/btnFollow1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/btn_bg"
            android:minHeight="44dp"
            android:textSize="13sp"
            android:text="…" />

        <Button
            android:id="@+id/btnFollow2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/btn_bg"
            android:minHeight="44dp"
            android:textSize="13sp"
            android:text="…" />
    </LinearLayout>

    <!-- 再安慰多啲：同一主題繼續生成（撳其他按鈕／發新嘢先會換主題） -->
    <Button
        android:id="@+id/btnMoreComfort"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/btn_bg"
        android:minHeight="44dp"
        android:text="💛 再安慰多啲"
        android:textSize="13sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/btnMic"
            android:layout_width="50dp"
            android:layout_height="46dp"
            android:text="🎤"
            android:textSize="17sp"
            android:background="@drawable/btn_bg"
            android:padding="0dp" />

        <EditText
            android:id="@+id/etInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:hint="或者打字都得…"
            android:maxLines="2"
            android:inputType="text"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnSend"
            android:layout_width="56dp"
            android:layout_height="46dp"
            android:layout_marginStart="6dp"
            android:text="送出"
            android:textSize="13sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:background="@drawable/btn_primary_bg"
            android:padding="0dp" />
    </LinearLayout>

    <Button
        android:id="@+id/btnGratitude"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/btn_bg"
        android:minHeight="44dp"
        android:text="🙏 想像你而家擁有乜嘢——想想你已經得到咗啲乜"
        android:textSize="13sp"
        android:textColor="#2E7D5B" />

    <Button
        android:id="@+id/btnNudge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/btn_bg"
        android:minHeight="44dp"
        android:text="🚀 推動力：想做咩？講出嚟"
        android:textSize="13sp"
        android:textColor="#2E7D5B" />

    <Button
        android:id="@+id/btnTimedNudge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/btn_bg"
        android:minHeight="44dp"
        android:text="⏰ 定時推動：延遲後提醒並逐步確認"
        android:textColor="#2E7D5B"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textSize="12sp"
        android:textColor="#4A6E5F" />
</LinearLayout>
